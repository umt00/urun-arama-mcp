# ── Ortam Değişkenleri ────────────────────────────────────────────
# Bu dosyayı kopyalayıp .env olarak kaydedin ve değerleri doldurun.
# cp .env.example .env

# Elasticsearch bağlantısı
ES_URL=https://your-es-cluster.example.com
ES_API_KEY=your-read-only-api-key
ES_TIMEOUT=30

# Güvenlik
INDEX_WHITELIST=urunler,products
MAX_RESULT_LIMIT=50

# penta-mcp-builder: Yetki Kontrolü
# Boş bırakılırsa yetki kontrolü devre dışı kalır (geliştirme modu).
# Production'da güçlü bir API key tanımlayın.
MCP_API_KEY=your-secure-api-key

# MCP Sunucu
MCP_HOST=0.0.0.0
MCP_PORT=8000
